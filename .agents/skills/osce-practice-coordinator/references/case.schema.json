{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSCE practice case 1.0",
  "type": "object",
  "required": ["schema_version", "station_id", "case_version", "title", "fictional", "learner", "mode", "design", "station_type", "number", "sign", "candidate", "examiner", "sp", "patient", "facts", "active_questions", "rubric", "sources", "validation"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "station_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "case_version": {"type": "string", "minLength": 1},
    "title": {"$ref": "#/$defs/text"},
    "fictional": {"const": true},
    "learner": {"$ref": "#/$defs/text"},
    "mode": {"enum": ["exam-practice", "author-learning"]},
    "design": {"type": "object", "required": ["objective", "core_task", "competencies", "decisions"], "properties": {"objective": {"$ref": "#/$defs/text"}, "core_task": {"$ref": "#/$defs/text"}, "competencies": {"$ref": "#/$defs/texts"}, "decisions": {"$ref": "#/$defs/texts"}}, "additionalProperties": false},
    "station_type": {"enum": ["history", "communication"]},
    "number": {"$ref": "#/$defs/text"},
    "sign": {"$ref": "#/$defs/text"},
    "candidate": {"type": "object", "required": ["background", "tasks", "notes", "report", "available_data"], "properties": {"background": {"$ref": "#/$defs/text"}, "tasks": {"$ref": "#/$defs/texts"}, "notes": {"$ref": "#/$defs/texts"}, "available_data": {"$ref": "#/$defs/text"}, "report": {"type": "object", "required": ["vitals", "symptoms", "other", "other_2"], "additionalProperties": {"type": "string"}}}, "additionalProperties": false},
    "examiner": {"type": "object", "required": ["setting", "sp_profile", "start_position", "summary", "differentials", "props"], "properties": {"setting": {"$ref": "#/$defs/text"}, "sp_profile": {"$ref": "#/$defs/text"}, "start_position": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "differentials": {"$ref": "#/$defs/texts"}, "props": {"$ref": "#/$defs/text"}}, "additionalProperties": false},
    "sp": {"type": "object", "required": ["setting", "start_position", "emotion", "manner", "voice", "principles", "summary", "dialogue", "room_diagram"], "properties": {"setting": {"$ref": "#/$defs/text"}, "start_position": {"$ref": "#/$defs/text"}, "emotion": {"$ref": "#/$defs/text"}, "manner": {"$ref": "#/$defs/text"}, "voice": {"$ref": "#/$defs/text"}, "principles": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "room_diagram": {"$ref": "#/$defs/text"}, "dialogue": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["frame", "candidate", "sp"], "properties": {"frame": {"$ref": "#/$defs/text"}, "candidate": {"$ref": "#/$defs/text"}, "sp": {"$ref": "#/$defs/text"}, "question": {"type": "boolean"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "patient": {"type": "object", "required": ["identity", "opening", "unknown_response", "emotion_rules", "teach_back"], "properties": {"identity": {"$ref": "#/$defs/text"}, "opening": {"$ref": "#/$defs/text"}, "unknown_response": {"$ref": "#/$defs/text"}, "emotion_rules": {"$ref": "#/$defs/text"}, "teach_back": {"$ref": "#/$defs/text"}}, "additionalProperties": false},
    "facts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "trigger", "response"], "properties": {"id": {"$ref": "#/$defs/text"}, "trigger": {"$ref": "#/$defs/text"}, "response": {"$ref": "#/$defs/text"}}, "additionalProperties": false}},
    "active_questions": {"type": "array", "items": {"type": "object", "required": ["id", "trigger", "text", "item_ids"], "properties": {"id": {"$ref": "#/$defs/text"}, "trigger": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/text"}, "item_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}, "additionalProperties": false}},
    "rubric": {"type": "object", "required": ["items", "max_score", "global_anchors"], "properties": {"max_score": {"type": "integer", "minimum": 1}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text", "anchors", "fact_ids", "star", "generic", "main_construct", "lqqopera", "sp_prompted"], "properties": {"id": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/text"}, "anchors": {"type": "object", "required": ["0", "1", "2"], "properties": {"0": {"$ref": "#/$defs/text"}, "1": {"$ref": "#/$defs/text"}, "2": {"$ref": "#/$defs/text"}}, "additionalProperties": false}, "fact_ids": {"$ref": "#/$defs/texts"}, "star": {"type": "boolean"}, "generic": {"type": "boolean"}, "main_construct": {"type": "boolean"}, "lqqopera": {"type": "boolean"}, "sp_prompted": {"type": "boolean"}}, "additionalProperties": false}}, "global_anchors": {"type": "object", "required": ["1", "2", "3", "4", "5"], "additionalProperties": {"$ref": "#/$defs/text"}}}, "additionalProperties": false},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "url", "use", "checked"], "properties": {"id": {"$ref": "#/$defs/text"}, "url": {"type": "string", "pattern": "^https://"}, "use": {"$ref": "#/$defs/text"}, "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}, "additionalProperties": false}},
    "validation": {"type": "object", "required": ["structure", "text_roleplay", "voice_live", "teacher_review"], "additionalProperties": {"type": "string"}}
  },
  "$defs": {"text": {"type": "string", "minLength": 1}, "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}
}
